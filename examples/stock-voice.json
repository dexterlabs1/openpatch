{
  "version": 2,
  "sample_rate": 48000,
  "nodes": [
    {
      "id": "motion",
      "kind": "stock_lfo",
      "params": {
        "rate": -1,
        "offset": 0
      }
    },
    {
      "id": "voice",
      "kind": "stock_vco",
      "params": {
        "frequency": -12,
        "pulse_width": 0.38,
        "fm_amount": 0.03
      }
    },
    {
      "id": "filter",
      "kind": "stock_vcf",
      "params": {
        "frequency": 0.5875530690739214,
        "resonance": 0.48,
        "drive": 0.15,
        "cutoff_cv_amount": 0.35
      }
    },
    {
      "id": "amplifier",
      "kind": "stock_vca",
      "params": {
        "level": 0.65,
        "response": 1
      }
    },
    {
      "id": "out",
      "kind": "audio_stereo",
      "params": {
        "gain": 0.15
      }
    },
    {
      "id": "clock",
      "kind": "gate",
      "params": {
        "frequency": 2,
        "duty": 0.35
      }
    },
    {
      "id": "envelope",
      "kind": "adsr_eg",
      "params": {
        "attack": 0.17,
        "decay": 0.46,
        "sustain": 0.18,
        "release": 0.48
      }
    },
    {
      "id": "scope",
      "kind": "scope",
      "params": {
        "time": 0.025,
        "trigger_enabled": 0,
        "x_scale": 1,
        "y_scale": 1
      }
    },
    {
      "id": "guide",
      "kind": "notes",
      "content": {
        "type": "notes",
        "text": "STOCK VOICE\nVCO saw \u2192 VCF LP\nVCF \u2192 VCA \u2192 stereo out\nClock \u2192 ADSR \u2192 VCA\nADSR also opens the filter.\nLFO adds gentle vibrato.\nScope X: filtered audio\nScope Y: high-pass audio\nTry Frequency, Cutoff\nand the LFO Rate.\nOriginal Rust DSP;\nstock-style digital models."
      }
    }
  ],
  "cables": [
    {
      "from": "motion",
      "output": "sine",
      "to": "voice",
      "input": "fm"
    },
    {
      "from": "voice",
      "output": "saw",
      "to": "filter",
      "input": "signal"
    },
    {
      "from": "clock",
      "output": "out",
      "to": "envelope",
      "input": "gate"
    },
    {
      "from": "envelope",
      "output": "out",
      "to": "filter",
      "input": "cutoff_cv"
    },
    {
      "from": "envelope",
      "output": "out",
      "to": "amplifier",
      "input": "cv"
    },
    {
      "from": "filter",
      "output": "lowpass",
      "to": "amplifier",
      "input": "signal"
    },
    {
      "from": "filter",
      "output": "lowpass",
      "to": "scope",
      "input": "x"
    },
    {
      "from": "filter",
      "output": "highpass",
      "to": "scope",
      "input": "y"
    },
    {
      "from": "amplifier",
      "output": "out",
      "to": "out",
      "input": "left"
    },
    {
      "from": "amplifier",
      "output": "out",
      "to": "out",
      "input": "right"
    }
  ],
  "output": "out"
}
