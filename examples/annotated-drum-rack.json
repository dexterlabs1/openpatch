    {
      "id": "guide",
      "kind": "notes",
      "content": {
        "type": "notes",
        "text": "DRUM LAB\n\nZ / X / C play kick, clap and hat.\n\nMIDI Gate \u2192 drums \u2192 mixer \u2192 stereo output.\n\nUse Learn to assign your own pads. Panic releases held gates.\n\nThe narrow Blank keeps the rhythm and mix sections apart."
      }
    },
    {
      "id": "spacer",
      "kind": "blank",
      "content": {
        "type": "blank",
        "width_hp": 3
      }
    },
    {
      "id": "pads",
      "kind": "midi_gate",
      "params": {
        "note1": 60,
        "note2": 62,
        "note3": 64,
        "velocity": 0,
        "mpe": 0,
        "channel": 0
      }
    },
    {
      "id": "kick",
      "kind": "drum_voice",
      "params": {
        "mode": 0,
        "pitch": 54,
        "decay": 0.32,
        "level": 0.85,
        "tone": 0.35,
        "drive": 0.12
      }
    },
    {
      "id": "clap",
      "kind": "drum_voice",
      "params": {
        "mode": 1,
        "pitch": 180,
        "decay": 0.12,
        "level": 0.52,
        "tone": 0.6,
        "drive": 0.05
      }
    },
    {
      "id": "hat",
