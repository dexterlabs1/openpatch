      "params": {
        "frequency": 2,
        "duty": 0.35
      }
    },
    {
      "id": "envelope",
      "kind": "adsr_eg",
      "params": {
        "attack": 0.17,
        "decay": 0.46,
        "sustain": 0.18,
        "release": 0.48
      }
    },
    {
      "id": "scope",
      "kind": "scope",
      "params": {
        "time": 0.025,
        "trigger_enabled": 0,
        "x_scale": 1,
        "y_scale": 1
      }
    },
    {
      "id": "guide",
      "kind": "notes",
      "content": {
        "type": "notes",
        "text": "FILTER VOICE\n\nSaw → VCF LP → VCA → out\nClock → ADSR → cutoff\nEnvelope opens the VCA.\n\nScope X: low-pass\nScope Y: high-pass\n\nCutoff: Hz or note entry\nDrive 100% = nominal\nCV depths are bipolar\n\nVCF has no lamps.\nScope shows real audio."
      }
    }
  ],
  "cables": [
    {
      "from": "voice",
      "output": "saw",
      "to": "filter",
      "input": "signal"
    },
    {
      "from": "clock",
      "output": "out",
      "to": "envelope",
      "input": "gate"
    },
    {
      "from": "envelope",
      "output": "out",
      "to": "filter",
      "input": "cutoff_cv"
    },
    {
      "from": "envelope",
      "output": "out",
      "to": "amplifier",
      "input": "cv"
    },
    {
      "from": "filter",
      "output": "lowpass",
      "to": "amplifier",
      "input": "signal"
    },
    {
      "from": "filter",
      "output": "lowpass",
      "to": "scope",
