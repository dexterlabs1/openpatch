      "params": {
        "frequency": 0.5875530690739214,
        "resonance": 0.48,
        "drive": 0.15,
        "cutoff_cv_amount": 0.35
      }
    },
    {
      "id": "amplifier",
      "kind": "analog_vca",
      "params": {
        "gain": 0.65
      }
    },
    {
      "id": "out",
