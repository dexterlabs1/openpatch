    {
      "id": "guide",
      "kind": "notes",
      "content": {
        "type": "notes",
        "text": "RHYTHM TERRAIN\nSOFT GROOVE\nX/Y explores drum maps.\nFILL sets each density.\nCHAOS varies each bar.\nAccents add to 6 V.\nLane 3 is a noise tick.\nTAP locks the tempo.\nRelease tap uses TEMPO."
      }
    },
    {
      "id": "console",
      "kind": "studio_mixer",
      "params": {
        "channels": 3,
        "level1": 0.65,
        "level2": 0.5,
        "level3": 0.4,
        "pan1": 0,
        "pan2": -0.2,
        "pan3": 0.25,
        "master": 0.7
      }
    },
    {
      "id": "out",
